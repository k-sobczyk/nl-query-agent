ai:
  gemini:
    api_key: "your-gemini-api-key-here"
    model: "gemini-2.5-flash"
  query:
    max_results: 100
    timeout_seconds: 30
    output_directory: "data"

database:
  url: "postgresql://username:password@hostname:port/database"
  host: "localhost"
  port: 54322
  name: "vehicle_telemetry"
  user: "telemetry_user"
  password: "secure_password_here"
  schema: "public"
  table: "telemetry"
  pool:
    min_size: 2
    max_size: 10
    timeout: 30

security:
  validation:
    max_vehicle_id_length: 100
    max_wildcards: 2
    battery_health:
      min: 0
      max: 100
    odometer_km:
      min: 0
      max: 10000000
  rate_limit:
    enabled: true
    requests_per_minute: 60

logging:
  level: "INFO"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file:
    enabled: true
    path: "logs/agent.log"
    max_bytes: 10485760
    backup_count: 5
  console:
    enabled: true
    colorize: true

application:
  environment: "production"
  debug: false

cache:
  enabled: false
  redis:
    host: "localhost"
    port: 6379
    db: 0
    password: ""
  ttl: 300
